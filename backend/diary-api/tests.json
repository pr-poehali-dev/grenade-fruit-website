{
  "tests": [
    {
      "name": "Healthcheck",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {"status": "ok"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login parent1",
      "method": "POST",
      "path": "/?action=login",
      "body": {"login": "parent1", "password": "parent1pass"},
      "expectedStatus": 200,
      "expectedBody": {"role": "parent"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login teacher",
      "method": "POST",
      "path": "/?action=login",
      "body": {"login": "Анна Сергеевна", "password": "teacher2024"},
      "expectedStatus": 200,
      "expectedBody": {"role": "teacher"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get classes",
      "method": "GET",
      "path": "/?action=get_classes",
      "expectedStatus": 200,
      "expectedBody": {"id": 1},
      "bodyMatcher": "array_contains"
    },
    {
      "name": "Get students",
      "method": "GET",
      "path": "/?action=get_students&class_id=14",
      "expectedStatus": 200,
      "expectedBody": {"full_name": "Алёша Петров"},
      "bodyMatcher": "array_contains"
    },
    {
      "name": "Update email missing user_id",
      "method": "POST",
      "path": "/?action=update_email",
      "body": {"email": "test@example.com"},
      "expectedStatus": 400,
      "expectedBody": {"error": "user_id required"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get schedule by teacher_name",
      "method": "GET",
      "path": "/?action=get_schedule&teacher_name=%D0%90%D0%BD%D0%BD%D0%B0%20%D0%A1%D0%B5%D1%80%D0%B3%D0%B5%D0%B5%D0%B2%D0%BD%D0%B0",
      "expectedStatus": 200,
      "expectedBody": {"teacher_name": "Анна Сергеевна"},
      "bodyMatcher": "array_contains"
    },
    {
      "name": "Get homework by teacher_id",
      "method": "GET",
      "path": "/?action=get_homework&teacher_id=7",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Get schedule_dates by teacher_name and school_year",
      "method": "GET",
      "path": "/?action=get_schedule_dates&teacher_name=%D0%90%D0%BB%D0%B5%D0%BA%D1%81%D0%B0%D0%BD%D0%B4%D1%80%20%D0%92%D0%B0%D0%BB%D0%B5%D1%80%D1%8C%D0%B5%D0%B2%D0%B8%D1%87&school_year=2026-2027",
      "expectedStatus": 200,
      "expectedBody": {"teacher_name": "Александр Валерьевич"},
      "bodyMatcher": "array_contains"
    },
    {
      "name": "Get extended day students",
      "method": "GET",
      "path": "/?action=get_extended_day_students",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Add extended day student missing id",
      "method": "POST",
      "path": "/?action=add_extended_day_student",
      "body": {},
      "expectedStatus": 400,
      "expectedBody": {"error": "student_id required"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get elective students",
      "method": "GET",
      "path": "/?action=get_elective_students",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Add elective student missing fields",
      "method": "POST",
      "path": "/?action=add_elective_student",
      "body": {},
      "expectedStatus": 400,
      "expectedBody": {"error": "student_id and subject required"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get chat messages missing class_id",
      "method": "GET",
      "path": "/?action=get_chat_messages",
      "expectedStatus": 400,
      "expectedBody": {"error": "class_id required"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get chat messages for class",
      "method": "GET",
      "path": "/?action=get_chat_messages&class_id=1",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Send chat message missing fields",
      "method": "POST",
      "path": "/?action=send_chat_message",
      "body": {},
      "expectedStatus": 400,
      "expectedBody": {"error": "class_id, sender_id, sender_name, sender_role required"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Send chat message success",
      "method": "POST",
      "path": "/?action=send_chat_message",
      "body": {"class_id": 14, "sender_id": 4, "sender_name": "Родитель Петрова", "sender_role": "parent", "text": "Тестовое сообщение"},
      "expectedStatus": 201,
      "expectedBody": {"text": "Тестовое сообщение"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Send chat message wrong class forbidden",
      "method": "POST",
      "path": "/?action=send_chat_message",
      "body": {"class_id": 1, "sender_id": 4, "sender_name": "Родитель Петрова", "sender_role": "parent", "text": "Чужой класс"},
      "expectedStatus": 403,
      "expectedBody": {"error": "Нет доступа к чату этого класса"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get chat unread count missing fields",
      "method": "GET",
      "path": "/?action=get_chat_unread_count",
      "expectedStatus": 400,
      "expectedBody": {"error": "class_id and user_id required"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get chat unread count",
      "method": "GET",
      "path": "/?action=get_chat_unread_count&class_id=14&user_id=4",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Mark chat read missing fields",
      "method": "POST",
      "path": "/?action=mark_chat_read",
      "body": {},
      "expectedStatus": 400,
      "expectedBody": {"error": "class_id and user_id required"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Mark chat read",
      "method": "POST",
      "path": "/?action=mark_chat_read",
      "body": {"class_id": 14, "user_id": 4},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    }
  ]
}