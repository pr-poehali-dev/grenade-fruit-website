{
  "tests": [
    {
      "name": "Healthcheck",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": {"status": "ok"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login parent1",
      "method": "POST",
      "path": "/?action=login",
      "body": {"login": "parent1", "password": "parent1pass"},
      "expectedStatus": 200,
      "expectedBody": {"role": "parent"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Login teacher",
      "method": "POST",
      "path": "/?action=login",
      "body": {"login": "Анна Сергеевна", "password": "teacher2024"},
      "expectedStatus": 200,
      "expectedBody": {"role": "teacher"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get classes",
      "method": "GET",
      "path": "/?action=get_classes",
      "expectedStatus": 200,
      "expectedBody": {"id": 1},
      "bodyMatcher": "array_contains"
    },
    {
      "name": "Get students",
      "method": "GET",
      "path": "/?action=get_students&class_id=14",
      "expectedStatus": 200,
      "expectedBody": {"full_name": "Алёша Петров"},
      "bodyMatcher": "array_contains"
    },
    {
      "name": "Update email missing user_id",
      "method": "POST",
      "path": "/?action=update_email",
      "body": {"email": "test@example.com"},
      "expectedStatus": 400,
      "expectedBody": {"error": "user_id required"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Get schedule by teacher_name",
      "method": "GET",
      "path": "/?action=get_schedule&teacher_name=%D0%90%D0%BD%D0%BD%D0%B0%20%D0%A1%D0%B5%D1%80%D0%B3%D0%B5%D0%B5%D0%B2%D0%BD%D0%B0",
      "expectedStatus": 200,
      "expectedBody": {"teacher_name": "Анна Сергеевна"},
      "bodyMatcher": "array_contains"
    },
    {
      "name": "Get homework by teacher_id",
      "method": "GET",
      "path": "/?action=get_homework&teacher_id=7",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    }
  ]
}